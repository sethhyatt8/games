# Same Firebase project as Artists is fine.
# Rooms live under games/ so they will not mix with Artists rooms/.
# This URL is public. Do not put API keys, tokens, or database secrets in this file.
VITE_FIREBASE_DATABASE_URL=https://artists-c1291-default-rtdb.firebaseio.com

# Asset base path. Leave unset for GitHub Pages (relative ./ paths).
# Domain-root hosting (Hostinger): npm run build:hostinger
# Or set VITE_BASE_PATH=/  (include the trailing slash for a subpath, e.g. /games/).
# VITE_BASE_PATH=/
